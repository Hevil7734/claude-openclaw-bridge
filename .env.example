# ==============================================================================
# Claude Gateway for OpenClaw Configuration Environment Variables
# ==============================================================================

# Server Network Settings
# STRICT SECURITY POLICY: Bind only to 127.0.0.1 (localhost)
CLAUDE_GW_HOST=127.0.0.1
CLAUDE_GW_PORT=8001

# Security / Authentication (optional API key)
# If empty or unset, localhost requests do not require Bearer authentication
CLAUDE_GW_API_KEY=

# Path to Claude Code CLI binary
# Defaults to detected 'claude' in PATH or ~/.local/bin/claude
CLAUDE_GW_BIN=claude

# Working directory for headless Claude CLI executions
# Subprocesses run here with --tools "" and --no-session-persistence
CLAUDE_GW_WORKSPACE_DIR=/tmp/claude-gateway

# Default Model and Reasoning Effort
# Supported models: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5, claude-fable-5-1
CLAUDE_GW_DEFAULT_MODEL=claude-sonnet-5-5

# Default effort: empty string disables passing --effort
# Options: low, medium, high, xhigh, max
CLAUDE_GW_DEFAULT_EFFORT=

# Process execution timeout in seconds
CLAUDE_GW_TIMEOUT=300

# Concurrency & Worker Pool Settings
# Maximum concurrent executions per worker instance
CLAUDE_GW_MAX_CONCURRENCY=4

# Pool dispatch mode: "least_busy" or "round_robin"
CLAUDE_GW_POOL_DISPATCH_MODE=least_busy

# Optional multi-account worker pool configuration
# Format: comma-separated list of worker_id:config_dir
# Example: CLAUDE_GW_WORKERS=claude2:~/.claude-profiles/claude2,claude3:~/.claude-profiles/claude3
CLAUDE_GW_WORKERS=

# Gateway server log file path
# CLAUDE_GW_LOG_FILE=/path/to/claude-gateway.log  (default: claude-gateway.log next to server.py)
